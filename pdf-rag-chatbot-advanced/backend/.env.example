# Gemini key is required for chat generation. Embeddings can fall back to local mode.
GOOGLE_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE

CHAT_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
# auto = Gemini until its daily quota is exhausted, then local; local = always local
EMBEDDING_PROVIDER=auto
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# auto = Gemini embeddings, with local fallback on daily quota exhaustion
# local = always use the local sentence-transformers model
# gemini = Gemini embeddings only; do not fall back
EMBEDDING_PROVIDER=auto
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=100
EMBEDDING_RPM_LIMIT=90
EMBEDDING_MAX_RETRIES=6
EMBEDDING_RETRY_BASE_SECONDS=5
EMBEDDING_MAX_RETRY_DELAY_SECONDS=70
TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_FILE_SIZE_MB=20
RELEVANCE_THRESHOLD=0.40
